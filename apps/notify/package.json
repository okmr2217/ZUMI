{
  "name": "@zumi/notify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../web/.wrangler/state --test-scheduled --var LOG_NOTIFICATION_TEXT:true --var NEXT_PUBLIC_APP_ENV:development",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@zumi/db": "*",
    "@zumi/types": "*",
    "@sentry/cloudflare": "^8.47.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "wrangler": "^4.126.0",
    "vitest": "^3.2.7"
  }
}

{
  "name": "@zumi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply zumi-db --local",
    "migrate:remote": "wrangler d1 migrations apply zumi-db --remote",
    "seed": "tsx scripts/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@zumi/types": "*",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "better-auth": "^1.1.13",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^3.101.0"
  }
}
